{
    "name": "redking/doctrine-parse-bundle",
    "description": "Doctrine ORM Bundle for Parse.com API",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/zeliard91/DoctrineParseBundle",
    "keywords": [ "parse", "symfony", "orm", "doctrine", "bundle"],
    "authors": [
        {
            "name": "Damien Matabon",
            "email": "damien.matabon@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/cache": "^1.11 || ^2.0",
        "doctrine/persistence": "^2.5 || ^3.0",
        "doctrine/data-fixtures": "^1.5.3",
        "parse/php-sdk": "^1.2|^2.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4",
        "symfony/config": "^5.4 || ^6.4 || ^7.4",
        "symfony/console": "^5.4 || ^6.4 || ^7.4",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.4",
        "symfony/doctrine-bridge": "^5.4 || ^6.4 || ^7.4",
        "symfony/string": "^5.4 || ^6.4 || ^7.4",
        "symfony/translation-contracts": "^1.1 || ^2 || ^3",
        "symfony/var-exporter": "^6.4 || ^7.4",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.4",
        "doctrine/collections": "^1.6 || ^2.0",
        "doctrine/instantiator": "^1.2 || ^2.0",
        "myclabs/deep-copy": "^1.7"
    },
    "require-dev": {
        "symfony/form": "^5.4 || ^6.4 || ^7.4",
        "symfony/validator": "^5.4 || ^6.4 || ^7.4",
        "symfony/maker-bundle": "^1.11",
        "symfony/mime": "^5.4 || ^6.4 || ^7.4",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.4",
        "phpunit/phpunit": "^10.5",
        "twig/twig": "^2.12 || ^3.0"
    },
    "autoload": {
        "psr-4": { "Redking\\ParseBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Redking\\ParseBundle\\Tests\\": "tests/" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
